<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core.xsd">


    <cache alias="popularPostsAllTimeCache">
        <expiry>
            <ttl unit="seconds">60</ttl> <!-- minut -->
        </expiry>
        <heap unit="entries">100</heap>

    </cache>

    <cache alias="popularPostsLast7DaysCache">
        <expiry>
            <ttl unit="seconds">30</ttl> <!-- pola minuta -->
        </expiry>
        <heap unit="entries">100</heap>
    </cache>

    <!-- Keš za fotografije iz objava -->
    <cache alias="imageCache">
        <expiry>
            <ttl unit="minutes">10</ttl>
        </expiry>
        <heap unit="entries">100</heap>
    </cache>

</config>
